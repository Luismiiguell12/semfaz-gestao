# =============================================================================
# SEMFAZ Gestão — variáveis do FRONTEND (copie para .env.local)
# Somente valores públicos: tudo o que vai para o build fica visível no navegador.
# NUNCA coloque aqui a service-role key, senhas ou tokens.
# =============================================================================

# Desenvolvimento local: valores exibidos por `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Caminho do GitHub Pages (https://<usuario>.github.io/semfaz-gestao)
NEXT_PUBLIC_BASE_PATH=/semfaz-gestao
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Somente para scripts administrativos LOCAIS (scripts/create-admin.mjs).
# Informe no próprio terminal, na hora da execução; não grave em arquivo.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=
# -----------------------------------------------------------------------------
