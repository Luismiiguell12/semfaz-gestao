# Variáveis das Edge Functions (sem segredos). Copie para supabase/functions/.env localmente.
# Em homologação/produção, configure com: supabase secrets set --env-file <arquivo>
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas pela plataforma.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173
APP_URL=http://localhost:3000/semfaz-gestao
